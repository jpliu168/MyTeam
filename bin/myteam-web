#!/usr/bin/env python3
"""myteam-web — the MyTeam control room in your browser."""
import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "lib"))

from myteam import profiles  # noqa: E402

sys.argv[1:] = profiles.apply_argv(sys.argv[1:])   # -p/--profile NAME

from myteam.web import main  # noqa: E402

if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(130)
